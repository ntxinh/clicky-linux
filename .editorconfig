root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust + TOML use 4 (see crates/, Cargo.toml asset lists)
[*.toml]
indent_size = 4

# Frontend + manifests use 2
[*.{json,yaml,yml}]
indent_size = 2

[ui/**]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
