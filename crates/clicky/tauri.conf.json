{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clicky",
  "version": "0.1.0",
  "identifier": "com.clicky.linux",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clicky",
        "width": 420,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
